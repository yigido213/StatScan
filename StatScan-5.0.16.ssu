{"manifest":"{\"format\":1,\"version\":\"5.0.16\",\"notes\":\"5.0.16 — Kovan beta 0.1.8: Otomatik güncelleyici (akış sütununun solunda küçük çubuk; uygulamaya tıkla → winget ile güncelleme kontrolü → onaylarsan güncelle; uygulamaları Başlat menüsünden kendisi bulur). Akış sütununda uygulama ekleme de tüm Başlat menüsünü arıyor.\",\"minLoader\":1,\"created\":\"2026-11-07T19:58:04.582Z\",\"files\":{\"StatScan.html\":{\"sha256\":\"1614f62468bcaede04709e49840b407ebcbad25b747099309b35074e2030b44c\",\"size\":1473560},\"desktop/app.js\":{\"sha256\":\"2089c241b75cb2c381040fcd38db5a0fa7852de25bbf612efe35f60f7887f0ec\",\"size\":14837},\"desktop/assets/icon.ico\":{\"sha256\":\"b0d623d0b828bcf7603ee02ac7b5cc8e9b27b13fdb5c3eff548f2cb7b7963543\",\"size\":372526},\"desktop/assets/icon.png\":{\"sha256\":\"6ce7c330fdcf2d8785ba7ea16895cc376bfbb22b4ee061da7a0692002c3ca376\",\"size\":99730},\"desktop/host.js\":{\"sha256\":\"a7da32bcae00fe75ad5ec3e0bf82ee4c00d60b122af7ab1e4f33bc08cca4ea6f\",\"size\":356034},\"desktop/preload.js\":{\"sha256\":\"9772a6e7784e24cee49eaf157883ee814545ba858730f62cf14ca25760b5bdca\",\"size\":9767},\"dyn/collector.ps1\":{\"sha256\":\"3329b8cdf5257002b1f0fbe10bbc0da8ed09103d33ff67618ab8d897a61b71cb\",\"size\":39356},\"dyn/README-dinamik.md\":{\"sha256\":\"da91e62f58ce365cdec59c1ec4b689c8cf0412e742c1ea728d8ba09394485b0d\",\"size\":7201},\"dyn/statscan-dyn.js\":{\"sha256\":\"bfc3f746e061f22ae93f36968e0952f2162470b39534a2d3f8c6489795b0f883\",\"size\":115235}}}","sig":"1Us4MmIj+C70X2uqsrXMT5BTas5QTxj0psg4FHE0TnifQDnaTafebQSYJeSCwfljpbPH0TcfqZmE+Qaewk3WAQ==","data":{"StatScan.html":"","desktop/app.js":"","desktop/assets/icon.ico":"","desktop/assets/icon.png":"","desktop/host.js":"","desktop/preload.js":"","dyn/collector.ps1":"","dyn/README-dinamik.md":"","dyn/statscan-dyn.js":""}}